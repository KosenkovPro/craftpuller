<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- Описание установщика для productbuild. Подстановки @VERSION@ и @MINMACOS@
     заменяются скриптом make-pkg.sh перед сборкой.

     ВАЖНО: текст элемента pkg-ref — это ИМЯ ФАЙЛА компонентного пакета
     относительно каталога поиска, который productbuild получает отдельной
     опцией, а атрибут id — идентификатор пакета. Если текст не совпадает
     с именем файла, productbuild лишь пишет предупреждение и собирает
     пустой установщик без приложения. -->
<installer-gui-script minSpecVersion="1">
    <title>Install CraftPull</title>
    <organization>io.github.kosenkovpro</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <welcome file="welcome.html"/>
    <license file="license.html"/>
    <os-version min="@MINMACOS@"/>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.kosenkovpro.craftpull"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.kosenkovpro.craftpull" visible="false">
        <pkg-ref id="io.github.kosenkovpro.craftpull"/>
    </choice>
    <pkg-ref id="io.github.kosenkovpro.craftpull" version="@VERSION@" onConclusion="none">io.github.kosenkovpro.craftpull.pkg</pkg-ref>
</installer-gui-script>
